<Window x:Class="AntivirusIA.UI.Views.PersistencePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        Title="CoreGuard - Nouveau programme au démarrage">
    <!-- Demande « Autoriser / Bloquer » pour une nouvelle persistance (affichée en bas à droite de l'écran) -->
    <Border Margin="16" Style="{StaticResource Card}" Padding="20" Background="{DynamicResource CardBrush}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Restore}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource WarnBrush}"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Nouveau programme au démarrage" Style="{StaticResource Text.Heading}" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>

            <ContentControl x:Name="RiskPill" Margin="0,12,0,0" HorizontalAlignment="Left"/>

            <TextBlock x:Name="KindText" Style="{StaticResource Text.Caption}" Margin="0,10,0,2"/>
            <TextBlock x:Name="TargetText" Style="{StaticResource Text.Strong}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CommandText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       FontFamily="Consolas"/>

            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="ExplanationTitle" Text="Analyse" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ExplanationText" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ResultText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="AllowButton" Content="Autoriser" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Click="OnAllow"
                        ToolTip="Ce programme pourra se lancer au démarrage ; CoreGuard ne redemandera pas."/>
                <Button x:Name="BlockButton" Content="Bloquer" Style="{StaticResource Btn.Danger}" Click="OnBlock"
                        ToolTip="Retire l'entrée de démarrage (fichier du dossier Démarrage mis en quarantaine, restaurable)."/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
