<UserControl x:Class="AntivirusIA.UI.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels">
    <UserControl.Resources>
        <!-- Champ mot de passe aux couleurs du thème (même rendu que les TextBox) -->
        <Style x:Key="Pwd" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1180" Margin="32,28,32,32">
            <TextBlock Text="Coffre-fort" Style="{StaticResource Text.Title}"/>
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,20" TextWrapping="Wrap"
                       Text="Vos mots de passe, chiffrés sur ce PC (Argon2id + AES-256-GCM). L'extension CoreGuard les remplit directement dans la page, sans passer par le presse-papiers, uniquement sur le site enregistré et jamais sur une page suspecte."/>

            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentTextBrush}"/>

            <!-- ===== Création ===== -->
            <Border x:Name="CreatePanel" Style="{StaticResource Card}" Padding="24" Visibility="Collapsed">
                <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                    <TextBlock Text="Créer votre coffre" Style="{StaticResource Text.Section}"/>
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,16"
                               Text="Choisissez un mot de passe maître (12 caractères minimum). Il chiffre tout le coffre : s'il est perdu, le contenu est irrécupérable."/>
                    <TextBlock Text="Mot de passe maître" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="CreateMaster" Style="{StaticResource Pwd}" AutomationProperties.Name="Mot de passe maître"/>
                    <TextBlock Text="Confirmation" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"/>
                    <PasswordBox x:Name="CreateConfirm" Style="{StaticResource Pwd}" AutomationProperties.Name="Confirmation du mot de passe maître"/>
                    <Button Content="Créer le coffre" Margin="0,18,0,0" HorizontalAlignment="Left" Click="OnCreate"/>
                </StackPanel>
            </Border>

            <!-- ===== Déverrouillage ===== -->
            <Border x:Name="UnlockPanel" Style="{StaticResource Card}" Padding="24" Visibility="Collapsed">
                <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Lock}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Coffre verrouillé" Style="{StaticResource Text.Section}"/>
                    </StackPanel>
                    <TextBlock Text="Mot de passe maître" Style="{StaticResource Text.Caption}" Margin="0,16,0,4"/>
                    <PasswordBox x:Name="UnlockMaster" Style="{StaticResource Pwd}" KeyDown="OnUnlockKey" AutomationProperties.Name="Mot de passe maître"/>
                    <Button Content="Déverrouiller" Margin="0,18,0,0" HorizontalAlignment="Left" Click="OnUnlock"/>
                </StackPanel>
            </Border>

            <!-- ===== Coffre ouvert ===== -->
            <StackPanel x:Name="OpenPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ajouter un identifiant" Style="{StaticResource Text.Section}"/>
                            <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" Command="{Binding LockCommand}"
                                    ToolTip="Efface la clé de la mémoire">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Lock}" Style="{StaticResource Ico}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Verrouiller"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding AutoLockText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Titre" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Tag="ex. Banque en ligne"/>
                            <TextBlock Grid.Column="2" Text="Adresse du site (https://)" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="3" Text="Identifiant" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="4" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Tag="adresse e-mail ou nom d'utilisateur"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Mot de passe" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <Grid Grid.Row="4" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="NewPassword" Style="{StaticResource Pwd}" AutomationProperties.Name="Mot de passe de l'identifiant"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Soft}" Content="Générer" Margin="8,0,0,0" Click="OnGenerate"
                                        ToolTip="Mot de passe aléatoire de 20 caractères"/>
                            </Grid>
                        </Grid>
                        <Button Content="Ajouter au coffre" Margin="0,16,0,0" HorizontalAlignment="Left" Click="OnAdd"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="8,8">
                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource Icon.Key}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Strong}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding Username, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Url, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Btn.DangerSoft}" Content="Supprimer"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
