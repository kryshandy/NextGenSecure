<UserControl x:Class="AntivirusIA.UI.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AntivirusIA.UI.Controls"
             xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels">
    <UserControl.Resources>
        <!-- Bouton chevron pour déplier le détail d'un résultat -->
        <Style x:Key="ChevronToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Width="36" Height="36" CornerRadius="10" Background="Transparent">
                            <Path x:Name="Chevron" Data="{StaticResource Icon.Chevron}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="{DynamicResource MutedBrush}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform x:Name="Rot" Angle="0"/></Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource CardHoverBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Rot" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Rot" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Style="{StaticResource Page.Root}" Margin="32,8,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Analyse" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Analysez un fichier ou un dossier : verdict local, puis explication de l'IA si nécessaire."
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ===== Zone de dépôt ===== -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16"
                    AllowDrop="True" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave">
                <Grid Margin="16">
                    <Rectangle x:Name="DropOutline" RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="5 4"
                               Stroke="{DynamicResource BorderBrush}" Fill="Transparent"/>
                    <StackPanel Margin="24" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <Path Data="{StaticResource Icon.Scan}" Width="28" Height="28" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Glissez un fichier ou un dossier ici" Style="{StaticResource Text.Heading}"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="ou choisissez-le avec les boutons ci-dessous" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Style="{StaticResource Btn.Secondary}" Command="{Binding PickFileCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.File}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Choisir un fichier"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Secondary}" Command="{Binding PickFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Choisir un dossier"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Margin="0,20,0,0" MinWidth="520">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}"
                                     AutomationProperties.Name="Chemin à analyser"/>
                            <Button Grid.Column="1" Content="Lancer l'analyse" Margin="8,0,0,0" Command="{Binding StartScanCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding AiStatus}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Progression ===== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Analyse en cours..." Style="{StaticResource Text.Heading}"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                     AutomationProperties.Name="Progression de l'analyse"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Annuler" Style="{StaticResource Btn.Secondary}" Margin="16,0,0,0"
                            VerticalAlignment="Center" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- ===== Résultats ===== -->
            <StackPanel Grid.Row="3" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Heading}" VerticalAlignment="Center"/>
                    <Button Content="Effacer" Style="{StaticResource Btn.Ghost}" Padding="10,5" HorizontalAlignment="Right"
                            Command="{Binding ClearCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScanItemViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:VerdictBadge Verdict="{Binding Verdict}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,16,0" MinWidth="88">
                                            <TextBlock Text="{Binding Score, StringFormat=Score {0}/100}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                                            <ProgressBar Value="{Binding Score, Mode=OneWay}" Height="5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="3" Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded}"
                                                      AutomationProperties.Name="Afficher le détail" ToolTip="Détail"/>
                                    </Grid>

                                    <!-- Détail : explication + indices + actions -->
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <Border CornerRadius="10" Padding="14" Background="{DynamicResource SurfaceBrush}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Path Data="{StaticResource Icon.Sparkle}" Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ExplanationSource}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding AiConfidenceText}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0"
                                                               Visibility="{Binding AiConfidenceText, Converter={StaticResource StringToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Body}"/>
                                                <TextBlock Text="{Binding Family, StringFormat=Famille supposée : {0}}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                                           Visibility="{Binding Family, Converter={StaticResource StringToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Indicators}" Margin="0,10,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="4,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Mettre en quarantaine" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                Style="{StaticResource Btn.Danger}" Command="{Binding QuarantineCommand}"
                                                Visibility="{Binding CanQuarantine, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Fichier mis en quarantaine." Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                                                   Visibility="{Binding IsQuarantined, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
