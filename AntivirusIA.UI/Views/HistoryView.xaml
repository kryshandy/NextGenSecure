<UserControl x:Class="AntivirusIA.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AntivirusIA.UI.Controls"
             xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels">
    <Grid Style="{StaticResource Page.Root}" Margin="32,8,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Historique" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Dernières analyses enregistrées dans la base locale." Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Actualiser" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrer l'historique"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0">
                <Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text=" analyse(s)"/>
            </TextBlock>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,48"
                            Visibility="{Binding VisibleCount, Converter={StaticResource ZeroToVis}}">
                    <Path Data="{StaticResource Icon.History}" Width="44" Height="44" Stretch="Uniform"
                          Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Aucune analyse à afficher." Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                               Visibility="{Binding Error, Converter={StaticResource StringToVis}}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding View}" Margin="8" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryRow}">
                                <Border x:Name="Row" Padding="12" Margin="0,0,0,4" CornerRadius="10" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:VerdictBadge Verdict="{Binding Verdict}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Score, StringFormat={}{0}/100}" Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center" Margin="8,0,16,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
