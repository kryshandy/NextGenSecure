<UserControl x:Class="AntivirusIA.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AntivirusIA.UI.Controls"
             xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels">
    <Grid Style="{StaticResource Page.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Historique" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Dernières analyses enregistrées dans la base locale." Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" VerticalAlignment="Top" Command="{Binding LoadCommand}"
                    ToolTip="Recharger l'historique" AutomationProperties.Name="Actualiser">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Ico}" Margin="0,0,8,0"/>
                    <TextBlock Text="Actualiser"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Recherche + filtre par verdict -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="38,8,12,8"
                         Tag="Rechercher un chemin ou un verdict" AutomationProperties.Name="Filtrer l'historique"/>
                <Path Data="{StaticResource Icon.Search}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource FaintBrush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip}" Content="Tous"
                             IsChecked="{Binding VerdictFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Malveillants"
                             IsChecked="{Binding VerdictFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Malicious}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Suspects"
                             IsChecked="{Binding VerdictFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Suspect}"/>
                <RadioButton Style="{StaticResource Chip}" Content="Sains"
                             IsChecked="{Binding VerdictFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Healthy}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0">
                <Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text=" sur "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" analyse(s)"/>
            </TextBlock>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-têtes de colonnes alignés sur les lignes -->
                <Grid Margin="20,8,28,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="VERDICT" Style="{StaticResource Text.Overline}"/>
                    <TextBlock Grid.Column="1" Text="FICHIER" Style="{StaticResource Text.Overline}" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="SCORE" Style="{StaticResource Text.Overline}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource Text.Overline}" HorizontalAlignment="Right"/>
                </Grid>

                <ctl:EmptyState Grid.Row="1" Icon="{StaticResource Icon.History}" Title="Aucune analyse à afficher"
                                Description="Les analyses terminées sont enregistrées ici. Lancez une analyse ou modifiez les filtres."
                                Visibility="{Binding VisibleCount, Converter={StaticResource ZeroToVis}}"/>
                <TextBlock Grid.Row="1" Text="{Binding Error}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Margin="0,0,0,24" Foreground="{DynamicResource DangerTextBrush}"
                           Visibility="{Binding Error, Converter={StaticResource StringToVis}}"/>

                <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding View}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryRow}">
                            <Border x:Name="Row" Style="{StaticResource Card.Interactive}" Padding="12" Margin="0,0,8,6">
                                <StackPanel>
                                    <Grid Background="Transparent" Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleExpandCommand}"/>
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <ctl:VerdictBadge Verdict="{Binding Verdict}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Strong}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding FullPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" ToolTip="{Binding FullPath}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                                            <TextBlock Text="{Binding Score, StringFormat={}{0}/100}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                                            <ProgressBar x:Name="ScoreBar" Height="5" Margin="0,4,0,0" Maximum="100" Value="{Binding Score, Mode=OneWay}"
                                                         Foreground="{DynamicResource SuccessBrush}" AutomationProperties.Name="Score de risque"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <ToggleButton Grid.Column="4" Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded}"
                                                      HorizontalAlignment="Right" AutomationProperties.Name="Afficher le détail" ToolTip="Afficher ou masquer le détail"/>
                                    </Grid>
                                    <Border CornerRadius="8" Padding="12" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Verdict}" Value="Suspect">
                                    <Setter TargetName="ScoreBar" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Verdict}" Value="Malveillant">
                                    <Setter TargetName="ScoreBar" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
