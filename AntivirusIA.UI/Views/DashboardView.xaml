<UserControl x:Class="AntivirusIA.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AntivirusIA.UI.Controls"
             xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels"
             xmlns:svc="clr-namespace:AntivirusIA.UI.Services"
             xmlns:mod="clr-namespace:AntivirusIA.UI.Models">
    <UserControl.Resources>
        <!-- Carte de statistique réutilisable : DataContext = ActivityStats ; l'icône vient de Tag -->
        <Style x:Key="StatIcon" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Style="{StaticResource Page.Root}" Margin="32,8,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Tableau de bord" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Vue d'ensemble de la protection en temps réel." Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ===== Statut global ===== -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <Border.Resources>
                    <!-- Couleurs du statut selon ProtectionLevel -->
                    <Style x:Key="HeroFill" TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Attention"><Setter Property="Fill" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Danger"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="HeroSoft" TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource SuccessSoftBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Attention"><Setter Property="Fill" Value="{DynamicResource WarnSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Danger"><Setter Property="Fill" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="HeroIcon" TargetType="Path">
                        <Setter Property="Data" Value="{StaticResource Icon.ShieldCheck}"/>
                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Attention">
                                <Setter Property="Data" Value="{StaticResource Icon.Warning}"/>
                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Danger">
                                <Setter Property="Data" Value="{StaticResource Icon.Bug}"/>
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="112" Height="112" Margin="0,0,24,0">
                        <Ellipse Style="{StaticResource HeroFill}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="Halo" ScaleX="0.8" ScaleY="0.8"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:2.2">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:2.2">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Width="84" Height="84" Style="{StaticResource HeroSoft}"/>
                        <Path Width="40" Height="40" Stretch="Uniform" Style="{StaticResource HeroIcon}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource Text.Title}" FontSize="24"/>
                        <TextBlock Text="{Binding StatusSubtitle}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding ModulesText}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="Simuler une alerte" Style="{StaticResource Btn.Secondary}" Command="{Binding SimulateAlertCommand}"
                                ToolTip="Injecte une alerte factice pour la démonstration"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Compteurs animés ===== -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,16" DataContext="{Binding Stats}">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                <Path Style="{StaticResource StatIcon}" Data="{StaticResource Icon.Scan}" Fill="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <ctl:CountUpTextBlock Value="{Binding FilesScanned}" Style="{StaticResource Text.Stat}" Margin="0,12,0,0"/>
                        <TextBlock Text="Fichiers analysés" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource DangerSoftBrush}">
                            <Path Style="{StaticResource StatIcon}" Data="{StaticResource Icon.Bug}" Fill="{DynamicResource DangerBrush}"/>
                        </Border>
                        <ctl:CountUpTextBlock Value="{Binding ThreatsFound}" Style="{StaticResource Text.Stat}" Margin="0,12,0,0"/>
                        <TextBlock Text="Menaces détectées" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource WarnSoftBrush}">
                            <Path Style="{StaticResource StatIcon}" Data="{StaticResource Icon.Quarantine}" Fill="{DynamicResource WarnBrush}"/>
                        </Border>
                        <ctl:CountUpTextBlock Value="{Binding Quarantined}" Style="{StaticResource Text.Stat}" Margin="0,12,0,0"/>
                        <TextBlock Text="En quarantaine" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Background="{DynamicResource SuccessSoftBrush}">
                            <Path Style="{StaticResource StatIcon}" Data="{StaticResource Icon.Bell}" Fill="{DynamicResource SuccessBrush}"/>
                        </Border>
                        <ctl:CountUpTextBlock Value="{Binding AlertCount}" Style="{StaticResource Text.Stat}" Margin="0,12,0,0"/>
                        <TextBlock Text="Alertes de la session" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Flux d'alertes + modules ===== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Alertes en temps réel" Style="{StaticResource Text.Heading}" VerticalAlignment="Center"/>
                            <Button Content="Effacer" Style="{StaticResource Btn.Ghost}" Padding="10,5" HorizontalAlignment="Right"
                                    Command="{Binding ClearAlertsCommand}"/>
                        </Grid>

                        <!-- État vide -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Alerts.Count, Converter={StaticResource ZeroToVis}}">
                            <Path Data="{StaticResource Icon.ShieldCheck}" Width="40" Height="40" Stretch="Uniform"
                                  Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Aucune alerte : tout est calme." Style="{StaticResource Text.Muted}" Margin="0,12,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Alerts}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type mod:AlertItem}">
                                        <Border x:Name="Row" Padding="12" Margin="0,0,0,8" CornerRadius="10"
                                                Background="{DynamicResource SurfaceBrush}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><TranslateTransform x:Name="Slide" X="0"/></Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" From="-16" To="0" Duration="0:0:0.3">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Badge" Width="32" Height="32" CornerRadius="9" VerticalAlignment="Top"
                                                        Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                                                    <Path x:Name="Ico" Data="{StaticResource Icon.Bell}" Width="16" Height="16" Stretch="Uniform"
                                                          Fill="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                                <Setter TargetName="Ico" Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                                <Setter TargetName="Ico" Property="Data" Value="{StaticResource Icon.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                <Setter TargetName="Ico" Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                <Setter TargetName="Ico" Property="Data" Value="{StaticResource Icon.Bug}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Modules de protection -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="État de la protection" Style="{StaticResource Text.Heading}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Modules}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:ProtectionModule}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}"
                                                 VerticalAlignment="Top" Margin="0,5,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Active">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Unavailable">
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
