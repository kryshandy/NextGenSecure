<Window x:Class="AntivirusIA.UI.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <!-- Saisie du mot de passe de protection : le dialogue reste ouvert tant que le service n'a pas répondu -->
    <Border Margin="24" Style="{StaticResource Card}" Padding="24" Background="{DynamicResource CardBrush}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Lock}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource DangerBrush}"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Heading}" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,12,0,16"/>

            <PasswordBox x:Name="Password" MinHeight="38" FontSize="14" Padding="12,8"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}" FocusVisualStyle="{x:Null}"
                         AutomationProperties.Name="Mot de passe de protection">
                <PasswordBox.Template>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </PasswordBox.Template>
            </PasswordBox>

            <TextBlock x:Name="ErrorText" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource DangerTextBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource Btn.Secondary}" IsCancel="True" Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource Btn.Danger}" IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
