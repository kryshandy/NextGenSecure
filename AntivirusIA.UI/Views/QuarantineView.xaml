<UserControl x:Class="AntivirusIA.UI.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels">
    <Grid Style="{StaticResource Page.Root}" Margin="32,8,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Quarantaine" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Fichiers isolés et chiffrés. Restaurez-les uniquement si vous êtes certain qu'ils sont sûrs."
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Actualiser" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,0,0,12"
                   Visibility="{Binding Message, Converter={StaticResource StringToVis}}"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,48"
                            Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}">
                    <Path Data="{StaticResource Icon.Quarantine}" Width="44" Height="44" Stretch="Uniform"
                          Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="La quarantaine est vide." Style="{StaticResource Text.Heading}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="Les fichiers détectés comme dangereux apparaîtront ici." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Items}" Margin="8" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuarantineRow}">
                                <Border Padding="12" Margin="0,0,0,4" CornerRadius="10" Background="Transparent" x:Name="Row">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource WarnSoftBrush}" Margin="0,0,14,0">
                                            <Path Data="{StaticResource Icon.Quarantine}" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource WarnBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding OriginalPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}"/>
                                            <TextBlock Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding Reason, Mode=OneWay}"/><Run Text="  -  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,16,0"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Padding="12,7"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Restore}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Restaurer"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Btn.Danger}" Padding="12,7"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Trash}" Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Supprimer"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
