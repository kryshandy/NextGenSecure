<UserControl x:Class="AntivirusIA.UI.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AntivirusIA.UI.Controls"
             xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels">
    <UserControl.Resources>
        <!-- Bandeau de message : vert en cas de succès, rouge en cas d'erreur -->
        <Style x:Key="MessageBanner" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MessageText" TargetType="TextBlock" BasedOn="{StaticResource Text.Strong}">
            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Quarantaine" Style="{StaticResource Text.Title}"/>
                    <ContentControl Style="{StaticResource Pill.Warn}" Margin="12,6,0,0" Padding="10,3" VerticalAlignment="Center"
                                    Visibility="{Binding Items.Count, Converter={StaticResource NonZeroToVis}}">
                        <TextBlock><Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text=" fichier(s) isolé(s)"/></TextBlock>
                    </ContentControl>
                </StackPanel>
                <TextBlock Text="Fichiers isolés et chiffrés. Restaurez-les uniquement si vous êtes certain qu'ils sont sûrs."
                           Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" VerticalAlignment="Top" Command="{Binding RefreshCommand}"
                    ToolTip="Recharger la liste" AutomationProperties.Name="Actualiser">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource Ico}" Margin="0,0,8,0"/>
                    <TextBlock Text="Actualiser"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource MessageBanner}" Margin="0,0,0,16"
                Visibility="{Binding Message, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding Message}" Style="{StaticResource MessageText}"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ctl:EmptyState Icon="{StaticResource Icon.Quarantine}" Title="La quarantaine est vide"
                                Description="Les fichiers détectés comme dangereux apparaîtront ici, chiffrés et neutralisés, jusqu'à ce que vous décidiez de les restaurer ou de les supprimer."
                                Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}"/>

                <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Items}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuarantineRow}">
                            <Border Style="{StaticResource Card.Interactive}" Margin="0,0,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource WarnSoftBrush}" Margin="0,0,16,0">
                                        <Path Data="{StaticResource Icon.Quarantine}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource WarnBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Strong}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding OriginalPath}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" ToolTip="{Binding OriginalPath}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ContentControl Style="{StaticResource Pill.Warn}" Content="{Binding Reason}" Margin="0,0,8,0" MaxWidth="320"/>
                                            <ContentControl Style="{StaticResource Pill}" Content="{Binding SizeText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                        <TextBlock Text="Isolé le" Style="{StaticResource Text.Overline}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Padding="12,7"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="Remettre le fichier à son emplacement d'origine (confirmation demandée)"
                                                AutomationProperties.Name="Restaurer">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Restore}" Style="{StaticResource Ico}" Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Restaurer"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn.DangerSoft}" Padding="12,7"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="Supprimer définitivement (confirmation demandée)"
                                                AutomationProperties.Name="Supprimer">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource Ico}" Width="14" Height="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="Supprimer"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
