<UserControl x:Class="AntivirusIA.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AntivirusIA.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Style="{StaticResource Page.Root}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Réglages" Style="{StaticResource Text.Title}"/>
                        <TextBlock Text="Seuils de détection, modules de protection et modèle d'IA." Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Apparence -->
                    <ctl:SectionCard Icon="{StaticResource Icon.Sun}" Title="Apparence" Subtitle="Le thème s'applique immédiatement.">
                        <StackPanel>
                        <ctl:SettingRow Title="Thème sombre" Description="Désactivez pour passer au thème clair.">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.DarkTheme}" AutomationProperties.Name="Thème sombre"/>
                        </ctl:SettingRow>
                        <ctl:SettingRow Title="Continuer en arrière-plan à la fermeture" Description="La fenêtre se masque ; la protection reste active (icône près de l'horloge).">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.RunInBackground}" AutomationProperties.Name="Continuer en arrière-plan"/>
                        </ctl:SettingRow>
                        <ctl:SettingRow Title="Lancer CoreGuard à l'ouverture de session" Description="Démarre caché dans la zone de notification (sans droits administrateur)." ShowSeparator="False">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.StartWithWindows}" AutomationProperties.Name="Lancer au démarrage"/>
                        </ctl:SettingRow>
                        </StackPanel>
                    </ctl:SectionCard>

                    <!-- Seuils de score -->
                    <ctl:SectionCard Icon="{StaticResource Icon.Settings}" Title="Seuils de score"
                                     Subtitle="Un fichier est classé selon son score de risque (0 à 100).">
                        <ctl:SectionCard.HeaderContent>
                            <Button Content="Valeurs par défaut" Style="{StaticResource Btn.Secondary}" MinHeight="32" Padding="12,4"
                                    Command="{Binding ResetThresholdsCommand}" ToolTip="Rétablir 30 (suspect) et 70 (malveillant)"/>
                        </ctl:SectionCard.HeaderContent>
                        <StackPanel>
                            <!-- Aperçu des trois bandes de verdict -->
                            <Grid Height="30" Margin="0,0,0,8" ToolTip="Répartition des scores selon les seuils">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding BandHealthy}"/>
                                    <ColumnDefinition Width="{Binding BandSuspect}"/>
                                    <ColumnDefinition Width="{Binding BandMalicious}"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="8,0,0,8" Margin="0,0,2,0">
                                    <TextBlock Text="Sain" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource WarnSoftBrush}" Margin="0,0,2,0">
                                    <TextBlock Text="Suspect" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarnTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource DangerSoftBrush}" CornerRadius="0,8,8,0">
                                    <TextBlock Text="Malveillant" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="0" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="100" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                            </Grid>

                            <ctl:SettingRow Title="Suspect à partir de" Description="Score minimal pour un fichier suspect">
                                <Grid Width="340">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="99" Value="{Binding Settings.ThresholdSuspect}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            AutomationProperties.Name="Seuil suspect"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Settings.ThresholdSuspect}" Style="{StaticResource Text.Section}"
                                               Foreground="{DynamicResource WarnTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Malveillant à partir de" Description="Score minimal pour un fichier malveillant" ShowSeparator="False">
                                <Grid Width="340">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="2" Maximum="100" Value="{Binding Settings.ThresholdMalicious}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            AutomationProperties.Name="Seuil malveillant"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Settings.ThresholdMalicious}" Style="{StaticResource Text.Section}"
                                               Foreground="{DynamicResource DangerTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ctl:SettingRow>
                        </StackPanel>
                    </ctl:SectionCard>

                    <!-- Analyse et IA -->
                    <ctl:SectionCard Icon="{StaticResource Icon.Sparkle}" Title="Analyse et IA locale"
                                     Subtitle="Comportement après détection et modèle d'explication.">
                        <StackPanel>
                            <ctl:SettingRow Title="Quarantaine automatique" Description="Isole immédiatement les fichiers jugés malveillants.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.AutoQuarantine}" AutomationProperties.Name="Quarantaine automatique"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Explication par l'IA" Description="Demande une explication au modèle local pour les fichiers douteux." ShowSeparator="False">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.UseAi}" AutomationProperties.Name="Explication par l'IA"/>
                            </ctl:SettingRow>

                            <TextBlock Text="Chemin du modèle (GGUF)" Style="{StaticResource Text.Strong}" Margin="0,16,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.ModelPath, UpdateSourceTrigger=PropertyChanged}" Tag="Chemin du fichier modèle .gguf"
                                         AutomationProperties.Name="Chemin du modèle"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" Command="{Binding BrowseModelCommand}"
                                        ToolTip="Parcourir pour choisir un fichier .gguf" MinHeight="38">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Ico}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Parcourir"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ContentControl Content="{Binding ModelStatus}" VerticalAlignment="Center" MaxWidth="640">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Pill.Warn}">
                                            <Setter Property="Tag" Value="{StaticResource Icon.Warning}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <Border CornerRadius="10" Background="{TemplateBinding Background}" Padding="12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{TemplateBinding Tag}" Width="14" Height="14" Stretch="Uniform"
                                                                      Fill="{TemplateBinding Foreground}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <ContentPresenter VerticalAlignment="Center">
                                                                    <ContentPresenter.Resources>
                                                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                                                    </ContentPresenter.Resources>
                                                                </ContentPresenter>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModelFound}" Value="True">
                                                    <Setter Property="Tag" Value="{StaticResource Icon.CheckCircle}"/>
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                            <TextBlock Text="{Binding ResolvedModelPath}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" ToolTip="{Binding ResolvedModelPath}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                       Text="Chemin relatif : résolu depuis le répertoire courant. Lancez l'application avec « dotnet run --project AntivirusIA.UI » depuis la racine du dépôt, ou saisissez un chemin absolu."/>
                        </StackPanel>
                    </ctl:SectionCard>

                    <!-- Modules -->
                    <ctl:SectionCard Icon="{StaticResource Icon.Shield}" Title="Modules de protection"
                                     Subtitle="Activez ou désactivez chaque protection temps réel, puis enregistrez.">
                        <StackPanel>
                            <ctl:SettingRow Title="Surveillance des téléchargements" Description="Analyse automatiquement chaque nouveau fichier du dossier Téléchargements.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.MonitorDownloads}" AutomationProperties.Name="Surveillance des téléchargements"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Fichiers leurres (canaris)" Description="Dépose des faux documents dans Documents, Bureau et Images pour piéger un ransomware. Retirés à la fermeture.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.CanariesEnabled}" AutomationProperties.Name="Fichiers leurres"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Comportement des processus (ETW)" Description="Nécessite les droits administrateur.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.BehaviorEnabled}" AutomationProperties.Name="Comportement des processus"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Persistance" Description="Clés Run, tâches planifiées, dossier Démarrage et services : fenêtre Autoriser / Bloquer pour chaque nouvelle entrée.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.PersistenceEnabled}" AutomationProperties.Name="Persistance"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Garde du presse-papiers" Description="Détecte le remplacement d'adresses crypto et efface les secrets copiés.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.ClipboardEnabled}" AutomationProperties.Name="Garde du presse-papiers"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Webcam et microphone" Description="Alerte quand une application utilise un capteur.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.SensorsEnabled}" AutomationProperties.Name="Webcam et microphone"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Interdire la caméra aux applications de bureau" Description="Paramètre de confidentialité Windows, appliqué immédiatement. Les applications du Store se gèrent une à une (bouton Couper du tableau de bord).">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DenyDesktopCamera}" AutomationProperties.Name="Interdire la caméra aux applications de bureau"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Interdire le micro aux applications de bureau" Description="Paramètre de confidentialité Windows, appliqué immédiatement.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DenyDesktopMicrophone}" AutomationProperties.Name="Interdire le micro aux applications de bureau"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Clavier (BadUSB)" Description="Bloque pendant 10 s une frappe automatique (débit surhumain ou cadence de machine). Peut gêner la saisie automatique d'un gestionnaire de mots de passe.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.BadUsbEnabled}" AutomationProperties.Name="Clavier BadUSB"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Mode paranoïa" Description="Politique de durcissement renforcée (USB, pare-feu, exécution depuis les dossiers utilisateur)." ShowSeparator="False">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.ParanoiaEnabled}" AutomationProperties.Name="Mode paranoïa"/>
                            </ctl:SettingRow>
                        </StackPanel>
                    </ctl:SectionCard>

                    <!-- Anti-phishing -->
                    <ctl:SectionCard Icon="{StaticResource Icon.Globe}" Title="Anti-phishing (extension navigateur)"
                                     Subtitle="Base locale : 100 000 domaines connus, liste noire OpenPhish, IA locale qui peut seulement aggraver un verdict.">
                        <StackPanel>
                            <ctl:SettingRow Title="Mettre à jour la liste noire par Internet" Description="Télécharge le flux OpenPhish toutes les 12 h. Désactivé : l'instantané livré reste utilisé, sans aucun accès réseau.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.PhishingFeedUpdates}" AutomationProperties.Name="Mise à jour de la liste noire"/>
                            </ctl:SettingRow>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FeedStatus}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Mettre à jour maintenant" Style="{StaticResource Btn.Secondary}" MinHeight="32" Padding="12,4"
                                        Margin="8,0,0,0" Command="{Binding UpdateFeedNowCommand}"/>
                            </Grid>
                            <ctl:SettingRow Title="Sites déclarés de confiance" Description="{Binding TrustedSitesText}" ShowSeparator="False">
                                <Button Content="Tout retirer" Style="{StaticResource Btn.Secondary}" MinHeight="32" Padding="12,4"
                                        Command="{Binding ClearTrustedSitesCommand}" IsEnabled="{Binding HasTrustedSites}"/>
                            </ctl:SettingRow>
                        </StackPanel>
                    </ctl:SectionCard>

                    <!-- Contrôle à distance par téléphone -->
                    <ctl:SectionCard Icon="{StaticResource Icon.Lock}" Title="Contrôle à distance (téléphone)"
                                     Subtitle="Verrouiller, déverrouiller, Mode Paranoïa depuis le téléphone : même Wi-Fi ou point d'accès mobile du PC, sans Internet.">
                        <StackPanel>
                            <TextBlock Text="{Binding RemoteStatus}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Associer un téléphone" Style="{StaticResource Btn.Secondary}" MinHeight="32" Padding="12,4" Margin="0,0,8,0"
                                        Command="{Binding PairPhoneCommand}"/>
                                <Button Content="Révoquer" Style="{StaticResource Btn.Secondary}" MinHeight="32" Padding="12,4" Margin="0,0,8,0"
                                        Command="{Binding RevokePhoneCommand}"/>
                                <Button Content="Point d'accès mobile de Windows" Style="{StaticResource Btn.Secondary}" MinHeight="32" Padding="12,4"
                                        Command="{Binding OpenHotspotSettingsCommand}"/>
                            </StackPanel>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding RemoteQrVisible, Converter={StaticResource BoolToVis}}">
                                <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Left">
                                    <Image Source="{Binding RemoteQr}" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock Text="{Binding RemoteUrls}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Sans box : activez le point d'accès mobile de Windows, connectez le téléphone à ce Wi-Fi, puis scannez. Le QR code contient la clé secrète : ne le montrez à personne."/>
                            </StackPanel>
                        </StackPanel>
                    </ctl:SectionCard>

                    <!-- Service et auto-défense -->
                    <ctl:SectionCard Icon="{StaticResource Icon.Lock}" Title="Service et auto-défense"
                                     Subtitle="Le service CoreGuard (SYSTEM) refuse les arrêts non autorisés et se relance s'il est tué.">
                        <StackPanel>
                            <TextBlock Text="{Binding ServiceStatus}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <ctl:SettingRow Title="Verrouillage d'urgence : couper aussi le réseau" Description="Le pare-feu bloque tout le trafic sortant tant que le PC est verrouillé.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.LockdownCutsNetwork}" AutomationProperties.Name="Couper le réseau au verrouillage"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Verrouiller le PC si un BadUSB est détecté" Description="Une frappe automatique (faux clavier USB) déclenche le verrouillage d'urgence.">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.LockOnBadUsb}" AutomationProperties.Name="Verrouiller si BadUSB"/>
                            </ctl:SettingRow>
                            <ctl:SettingRow Title="Désactiver la protection" ShowSeparator="False"
                                            Description="Arrête le service et son watchdog. Exige le mot de passe de protection (défi-réponse HMAC : le mot de passe ne transite pas).">
                                <Button Style="{StaticResource Btn.DangerSoft}" Command="{Binding StopProtectionCommand}"
                                        ToolTip="Demande le mot de passe de protection">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Lock}" Style="{StaticResource Ico}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Désactiver…"/>
                                    </StackPanel>
                                </Button>
                            </ctl:SettingRow>
                            <TextBlock Text="{Binding StopMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource SuccessTextBrush}"
                                       Margin="0,8,0,0" Visibility="{Binding StopMessage, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                    </ctl:SectionCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Barre d'actions fixe : toujours visible, quel que soit le défilement -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="1180" Margin="32,12" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Icon.CheckCircle}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource SuccessBrush}"
                          Margin="0,0,8,0" VerticalAlignment="Center"
                          Visibility="{Binding SavedMessage, Converter={StaticResource StringToVis}}"/>
                    <TextBlock Text="{Binding SavedMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                               Foreground="{DynamicResource SuccessTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ApplyCommand}" ToolTip="Enregistre les réglages et redémarre les modules de protection">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource Ico}" Margin="0,0,8,0"/>
                        <TextBlock Text="Enregistrer et appliquer"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
