<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AntivirusIA.UI</RootNamespace>
    <ApplicationIcon>Assets\coreguard.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\coreguard-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntivirusIA.AI\AntivirusIA.AI.csproj" />
    <ProjectReference Include="..\AntivirusIA.Core\AntivirusIA.Core.csproj" />
    <ProjectReference Include="..\AntivirusIA.Engines\AntivirusIA.Engines.csproj" />
    <ProjectReference Include="..\AntivirusIA.Infrastructure\AntivirusIA.Infrastructure.csproj" />
    <ProjectReference Include="..\CoreGuard.RealTime\CoreGuard.RealTime.csproj" />
    <ProjectReference Include="..\CoreGuard.Behavior\CoreGuard.Behavior.csproj" />
    <ProjectReference Include="..\CoreGuard.Network\CoreGuard.Network.csproj" />
    <ProjectReference Include="..\CoreGuard.Privacy\CoreGuard.Privacy.csproj" />
    <ProjectReference Include="..\CoreGuard.Response\CoreGuard.Response.csproj" />
    <ProjectReference Include="..\CoreGuard.Ipc\CoreGuard.Ipc.csproj" />
    <ProjectReference Include="..\CoreGuard.Devices\CoreGuard.Devices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

</Project>
