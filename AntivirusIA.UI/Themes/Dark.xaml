<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette Dark : mêmes clés que l'autre thème, échangées à chaud par ThemeService -->
    <Color x:Key="BgColor">#0B0F1A</Color>
    <Color x:Key="AccentColor">#4272F0</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#0B0F1A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0F1424"/>
    <SolidColorBrush x:Key="CardBrush" Color="#151B2E"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1B2338"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#26304A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EAF0FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA7C4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4272F0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6B93FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A64E6"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F2C55"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F43F5E"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#12332B"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#3A2C0E"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3F1621"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FDA4AF"/>
</ResourceDictionary>
