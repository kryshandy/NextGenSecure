<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette sombre : mêmes clés que Light.xaml, échangées à chaud par ThemeService.
         Contrastes visés : texte >= 4,5:1 (AA) sur les surfaces, éléments graphiques >= 3:1. -->
    <Color x:Key="BgColor">#0A0E1A</Color>
    <Color x:Key="AccentColor">#3A66E8</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBrush" Color="#0A0E1A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0E1322"/>
    <SolidColorBrush x:Key="CardBrush" Color="#141A2C"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1A2236"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#1B2338"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#242E48"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A476A"/>

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A0ACC8"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#7886A6"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3A66E8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B84FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F55CC"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2850"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#8FADFF"/>

    <!-- Couleurs sémantiques : Sain / Suspect / Malveillant / Info -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F43F5E"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0F2F28"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#37290D"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3D1522"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#15284A"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FDA4AF"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#93C5FD"/>

    <!-- Dégradé de marque et fonds de héros -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B8CFF" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18213C" Offset="0"/>
        <GradientStop Color="#121829" Offset="0.65"/>
        <GradientStop Color="#141A2C" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="GlowSuccessBrush">
        <GradientStop Color="#5534D399" Offset="0"/>
        <GradientStop Color="#0034D399" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowWarnBrush">
        <GradientStop Color="#55F59E0B" Offset="0"/>
        <GradientStop Color="#00F59E0B" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowDangerBrush">
        <GradientStop Color="#66F43F5E" Offset="0"/>
        <GradientStop Color="#00F43F5E" Offset="1"/>
    </RadialGradientBrush>
    <!-- Ombres douces (statiques : un Effect ne se rethème pas à chaud, la ressource est échangée avec le dictionnaire) -->
    <DropShadowEffect x:Key="Shadow.Card" Color="#000000" Opacity="0.32" BlurRadius="22" ShadowDepth="5" Direction="270"/>
    <DropShadowEffect x:Key="Shadow.Raised" Color="#000000" Opacity="0.5" BlurRadius="40" ShadowDepth="12" Direction="270"/>
</ResourceDictionary>
