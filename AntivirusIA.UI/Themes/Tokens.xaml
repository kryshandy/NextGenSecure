<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- ===== Jetons de design (indépendants du thème) =====
         Échelle d'espacement : 4 / 8 / 12 / 16 / 24 / 32.
         Échelle typographique : Display 40, Titre 28, Section 18, Sous-titre 15, Corps 14, Légende 12.
         Rayons : 8 (contrôles), 12 (cartes), 16 (héros), 999 (pastilles). -->

    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>

    <!-- Marge des pages : identique partout pour un alignement strict des titres -->
    <Thickness x:Key="Page.Margin">32,20,32,32</Thickness>
    <sys:Double x:Key="Page.MaxWidth">1180</sys:Double>

    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Hero">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>

    <sys:Double x:Key="Font.Display">40</sys:Double>
    <sys:Double x:Key="Font.Title">28</sys:Double>
    <sys:Double x:Key="Font.Section">18</sys:Double>
    <sys:Double x:Key="Font.Subtitle">15</sys:Double>
    <sys:Double x:Key="Font.Body">14</sys:Double>
    <sys:Double x:Key="Font.Caption">12</sys:Double>

    <!-- Durées d'animation -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Base">0:0:0.2</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.32</Duration>
</ResourceDictionary>
