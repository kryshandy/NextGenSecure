<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette Light : mêmes clés que l'autre thème, échangées à chaud par ThemeService -->
    <Color x:Key="BgColor">#F3F5FA</Color>
    <Color x:Key="AccentColor">#2F5DE0</Color>
    <Color x:Key="ShadowColor">#1E293B</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#F3F5FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F5F7FC"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE3EF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#475569"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F5DE0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#274FC4"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F3FA0"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EBFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E11D48"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#D9F5E9"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FDEBCB"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDDDE4"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#065F46"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#92400E"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#9F1239"/>
</ResourceDictionary>
