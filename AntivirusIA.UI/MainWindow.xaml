<Window x:Class="AntivirusIA.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AntivirusIA.UI.ViewModels"
        xmlns:views="clr-namespace:AntivirusIA.UI.Views"
        Title="CoreGuard" Icon="/Assets/coreguard-256.png"
        Width="1280" Height="800" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Association ViewModel -> Vue -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><views:ScanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}"><views:QuarantineView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Barre latérale ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,8,0,0">
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6B93FF" Offset="0"/>
                                <GradientStop Color="#7C4DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource Icon.ShieldCheck}" Fill="White" Width="22" Height="22" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CoreGuard" Style="{StaticResource Text.Heading}" FontSize="19"/>
                        <TextBlock Text="Protection nouvelle génération" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="0,8,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding IsSelected}"
                                    AutomationProperties.Name="{Binding Title}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Pied : bascule de thème -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Effect="{x:Null}" Background="{DynamicResource CardBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Thème" Style="{StaticResource Text.Heading}" FontSize="13"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Text" Value="Clair"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Text" Value="Sombre"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Padding="10,8"
                                Command="{Binding ToggleThemeCommand}" ToolTip="Basculer thème sombre / clair"
                                AutomationProperties.Name="Basculer le thème">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource TextBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource Icon.Sun}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Moon}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Zone de contenu ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre de titre : zone de déplacement + boutons de fenêtre -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionBtn}" Tag="{StaticResource Icon.Minimize}" Click="OnMinimize"
                        AutomationProperties.Name="Réduire" ToolTip="Réduire"/>
                <Button Style="{StaticResource CaptionBtn}" Tag="{StaticResource Icon.Maximize}" Click="OnMaximize"
                        AutomationProperties.Name="Agrandir" ToolTip="Agrandir / restaurer"/>
                <Button Style="{StaticResource CaptionBtn.Close}" Tag="{StaticResource Icon.Close}" Click="OnClose"
                        AutomationProperties.Name="Fermer" ToolTip="Fermer"/>
            </StackPanel>

            <ContentControl Grid.Row="1" Content="{Binding Current.ViewModel}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
