<Window x:Class="CoreGuard.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation de CoreGuard" Width="640" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#0F1320" FontFamily="Segoe UI" FontSize="14" Foreground="#E8EBF3">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A3350"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3B6CF6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EBF3"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1F2433"/>
            <Setter Property="Foreground" Value="#E8EBF3"/>
            <Setter Property="BorderBrush" Value="#39405A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/coreguard-256.png" Width="44" Height="44" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Installation de CoreGuard" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="StepText" Style="{StaticResource Muted}"/>
            </StackPanel>
        </StackPanel>

        <!-- 1. Bienvenue -->
        <StackPanel x:Name="PageWelcome" Grid.Row="1" Margin="0,22,0,0">
            <TextBlock TextWrapping="Wrap" Text="Cet assistant installe CoreGuard sur cet ordinateur, entièrement hors ligne : rien n'est téléchargé."/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" Text="Contenu :"/>
            <TextBlock Style="{StaticResource Muted}" Margin="12,6,0,0" Text="• l'application CoreGuard (runtime .NET inclus) et son icône près de l'horloge&#x0a;• l'IA locale : modèle de langage Llama 3.2 3B (explications, anti-phishing) et classifieur EMBER / ONNX&#x0a;• le service de protection SYSTEM (auto-défense, ETW, leurres, Mode Paranoïa, contrôle à distance)&#x0a;• le fournisseur AMSI (analyse des scripts avant exécution)&#x0a;• l'hôte de l'extension navigateur (anti-phishing, coffre-fort) et l'extension&#x0a;• le guide d'utilisation et les spécimens de démonstration inoffensifs"/>
            <TextBlock x:Name="SizeText" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Dossier : C:\Program Files\CoreGuard"/>
        </StackPanel>

        <!-- 2. Mot de passe -->
        <StackPanel x:Name="PagePassword" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Text="Mot de passe de protection : il sera exigé pour arrêter CoreGuard, désactiver le Mode Paranoïa, déverrouiller le PC ou associer un téléphone. Un logiciel malveillant ne peut donc pas désactiver la protection."/>
            <StackPanel x:Name="CurrentPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="Mot de passe ACTUEL (CoreGuard est déjà installé : il protège son service contre l'arrêt)"/>
                <PasswordBox x:Name="CurrentPassword"/>
                <CheckBox x:Name="KeepPassword" Content="Conserver ce mot de passe" IsChecked="True" Checked="OnKeepChanged" Unchecked="OnKeepChanged"/>
            </StackPanel>
            <StackPanel x:Name="NewPanel" Margin="0,14,0,0">
                <TextBlock Text="Nouveau mot de passe (8 caractères minimum)"/>
                <PasswordBox x:Name="NewPassword"/>
                <TextBlock Text="Confirmation"/>
                <PasswordBox x:Name="ConfirmPassword"/>
            </StackPanel>
            <TextBlock x:Name="PasswordError" Foreground="#FF8A8A" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 3. Options -->
        <StackPanel x:Name="PageOptions" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
            <CheckBox x:Name="OptService" IsChecked="True" Content="Service de protection SYSTEM (recommandé : auto-défense, leurres, Mode Paranoïa, contrôle à distance)"/>
            <CheckBox x:Name="OptAmsi" IsChecked="True" Content="Fournisseur AMSI (bloque les scripts malveillants avant exécution)"/>
            <CheckBox x:Name="OptBrowser" IsChecked="True" Content="Hôte de l'extension navigateur (Chrome, Edge, Brave)"/>
            <CheckBox x:Name="OptDesktop" IsChecked="True" Content="Raccourci sur le Bureau"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" Text="L'extension elle-même se charge ensuite dans le navigateur (mode développeur > « Charger l'extension non empaquetée » > C:\Program Files\CoreGuard\Extension) : le guide l'explique pas à pas."/>
        </StackPanel>

        <!-- 4. Progression / fin -->
        <Grid x:Name="PageProgress" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="Progress" Height="8" Maximum="100" Foreground="#3B6CF6" Background="#1F2433" BorderThickness="0"/>
            <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" Background="#161B2B" Foreground="#C5CAD8"
                     BorderThickness="0" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            <StackPanel x:Name="UninstallOptions" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="Mot de passe de protection (pour arrêter le service)"/>
                <PasswordBox x:Name="UninstallPassword"/>
                <CheckBox x:Name="RemoveData" Content="Supprimer aussi mes données (réglages, quarantaine, coffre-fort, mot de passe de protection)"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BackButton" Content="Précédent" Click="OnBack" Visibility="Collapsed"/>
            <Button x:Name="NextButton" Content="Suivant" Style="{StaticResource Primary}" Click="OnNext"/>
            <Button x:Name="CloseButton" Content="Annuler" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
