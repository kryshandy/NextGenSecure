{
  "manifest_version": 3,
  "name": "CoreGuard Browser Shield",
  "version": "0.3.0",
  "description": "Anti-phishing (base de confiance, OCR, QR, IA locale) et auto-remplissage sécurisé depuis le coffre CoreGuard.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CoreGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "analyser-page": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Analyser cette page (OCR + IA locale)"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
