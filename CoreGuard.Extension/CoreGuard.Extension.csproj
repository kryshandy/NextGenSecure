<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows 10 SDK requis pour les projections WinRT (Windows.Media.Ocr). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CoreGuard.Extension</AssemblyName>
    <RootNamespace>CoreGuard.Extension</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntivirusIA.Core\AntivirusIA.Core.csproj" />
    <ProjectReference Include="..\CoreGuard.Ipc\CoreGuard.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Extension, manifeste hote et notice copies a cote de l'executable. -->
    <None Include="extension\**" CopyToOutputDirectory="PreserveNewest" LinkBase="extension" />
    <None Include="com.coreguard.host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="INSTALL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
